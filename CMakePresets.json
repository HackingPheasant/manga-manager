{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "displayName": "Base",
            "description": "Base configuration",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS" : "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "inherits": "base",
            "name": "dev",
            "displayName": "Developer",
            "description": "Build as Debug, with warnings enabled. Inteneded for use by developers.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_COMPILE_WARNINGS": "ON",
                "BUILD_DOCUMENTATION": "ON",
                "BUILD_EXAMPLES": "ON",
                "BUILD_TESTING": "ON"
            },
            "warnings": {
                "dev": false,
                "deprecated": true,
                "uninitialized": true,
                "unusedCli": true,
                "systemVars": true
            },
            "errors": {
                "dev": false,
                "deprecated": true
            },
            "trace": {
                "mode": "off",
                "format": "human"
            }
        },
        {
            "inherits": "base",
            "name": "debug",
            "displayName": "Debug",
            "description": "Build as Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "inherits": "base",
            "name": "release",
            "displayName": "Release",
            "description": "Build as Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "inherits": "base",
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "Build as Release with Debug Info",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "displayName": "Developer",
            "description": "Build as Debug, with warnings enabled. Inteneded for use by developers.",
            "configurePreset": "dev",
            "jobs": 4
        },
        {
            "name": "debug",
            "displayName": "debug",
            "description": "Build as Debug",
            "configurePreset": "debug",
            "jobs": 4
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Build as Release",
            "configurePreset": "release",
            "jobs": 4
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "Build as Release with Debug Info",
            "configurePreset": "relwithdebinfo",
            "jobs": 4
        }
    ],
    "testPresets": [
        {
            "name": "unit-testing",
            "displayName": "Unit Testing",
            "description": "Automated unit testing of libraries and applications.",
            "configurePreset": "dev",
            "output": {
                "shortProgress": true,
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 4,
                "scheduleRandom": true
            }
        },
        {
            "name": "fuzzing",
            "displayName": "Fuzzing",
            "description": "Automated fuzzing of libraries and applications.",
            "configurePreset": "dev",
            "output": {
                "shortProgress": true,
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 4,
                "scheduleRandom": true
            }
        }
    ],
    "packagePresets": [
        {
            "name": "dev",
            "displayName": "dev",
            "description": "A packaged Developer (Debug) build, built with usage of potential development only related flags and dependencies",
            "configurePreset": "dev"
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "A packaged Debug build",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "A packaged Release build",
            "configurePreset": "release"
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "A packaged Release build including Debug Info",
            "configurePreset": "relwithdebinfo"
        }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "displayName": "Developer",
            "description": "Basic developer workflow, with compiler warnings (Configure, Build, Test, Package).",
            "steps": [
                {
                    "type": "configure",
                    "name": "dev"
                },
                {
                    "type": "build",
                    "name": "dev"
                },
                {
                    "type": "test",
                    "name": "unit-testing"
                },
                {
                    "type": "package",
                    "name": "dev"
                }
            ]
        },
        {
            "name": "fuzzing",
            "displayName": "Fuzzing",
            "description": "Automated Fuzzing of the projects libraries and applications.",
            "steps": [
                {
                    "type": "configure",
                    "name": "dev"
                },
                {
                    "type": "build",
                    "name": "dev"
                },
                {
                    "type": "test",
                    "name": "fuzzing"
                }
            ]
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Basic Debug Release (Configure, Build, Package)",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                },
                {
                    "type": "package",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Basic Release (Configure, Build, Package)",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "package",
                    "name": "release"
                }
            ]
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "Basic Release including Debug Info (Configure, Build, Package)",
            "steps": [
                {
                    "type": "configure",
                    "name": "relwithdebinfo"
                },
                {
                    "type": "build",
                    "name": "relwithdebinfo"
                },
                {
                    "type": "package",
                    "name": "relwithdebinfo"
                }
            ]
        }
    ]
}
